{
  "name": "dsh-workspace-mention",
  "version": "0.1.0",
  "description": "在 DSH Web 输入框里用 @ 引用任意工作区：列出侧栏里的每个工作区，选中后插入它的根目录引用。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/client.test.mjs test/workspace-brief.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mention",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zero0-A/dsh-workspace-mention.git"
  },
  "homepage": "https://github.com/Zero0-A/dsh-workspace-mention#readme",
  "bugs": {
    "url": "https://github.com/Zero0-A/dsh-workspace-mention/issues"
  },
  "author": "Zero0-A",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
